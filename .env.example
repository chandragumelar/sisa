# Supabase — isi dari Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# VAPID public key untuk Web Push — generate dengan: npx web-push generate-vapid-keys
# Private key TIDAK masuk ke sini, hanya di server (edge function / cron)
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# License signing — HANYA untuk generate lisensi lokal (scripts/gen-license.ts)
# Private key Ed25519. JANGAN commit nilai aslinya, JANGAN taro di command line.
# Isi di .env lokal (yang di-gitignore), bukan di sini.
SISA_PRIVATE_KEY=your-ed25519-private-key-spki-base64
